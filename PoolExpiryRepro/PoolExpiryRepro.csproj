<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SnowflakeDataVersion Condition="'$(SnowflakeDataVersion)' == ''">6.5.0</SnowflakeDataVersion>
  </PropertyGroup>

  <!-- The released package by default. To test a source checkout instead, pass
       -p:SnowflakeDataProject=<path to Snowflake.Data.csproj>. -->
  <ItemGroup Condition="'$(SnowflakeDataProject)' == ''">
    <PackageReference Include="Snowflake.Data" Version="$(SnowflakeDataVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(SnowflakeDataProject)' != ''">
    <ProjectReference Include="$(SnowflakeDataProject)" />
  </ItemGroup>
</Project>
